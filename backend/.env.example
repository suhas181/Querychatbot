# Copy this file to .env and fill in your own values.
SECRET_KEY=change-this-to-a-long-random-string
FLASK_DEBUG=1
# macOS runs AirPlay Receiver on port 5000, so 8000 is the default
PORT=8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-root-password
DB_NAME=college_chatbot

MIN_CATEGORY_CONFIDENCE=0.20
MIN_SIMILARITY=0.35

# ---------------------------------------------------------------------------
# Optional: grounded fallback
#
# Used only for questions TF-IDF and Naive Bayes cannot match. The model is
# given the college's own database and told to answer from that alone, so it
# cannot invent a faculty name or a phone number. Leave GEMINI_API_KEY blank
# and the chatbot behaves exactly as before — it declines politely instead.
#
# Free key (no card needed): https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
LLM_TIMEOUT=12
LLM_ENABLED=1
LLM_DEBUG=0

# ---------------------------------------------------------------------------
# Deployment only — not needed on a laptop
# ---------------------------------------------------------------------------
# Managed MySQL providers refuse unencrypted connections. Set DB_SSL=1 for
# them; point DB_SSL_CA at the provider's CA certificate to verify it too.
DB_SSL=0
DB_SSL_CA=

# Secret for /tasks/restore, which an external scheduler calls daily because
# free hosting has no cron. Blank disables the route.
TASK_TOKEN=
